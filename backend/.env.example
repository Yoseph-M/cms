DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cafeflow?retryWrites=true&w=majority&appName=Cluster0&maxPoolSize=10&minPoolSize=2&maxIdleTimeMS=60000&connectTimeoutMS=10000&socketTimeoutMS=45000&serverSelectionTimeoutMS=10000"
# Connection pool parameters explained:
# maxPoolSize=10: Maximum 10 concurrent connections
# minPoolSize=2: Keep at least 2 connections alive
# maxIdleTimeMS=60000: Close idle connections after 60 seconds
# connectTimeoutMS=10000: 10 second timeout for initial connection
# socketTimeoutMS=45000: 45 second timeout for socket operations
# serverSelectionTimeoutMS=10000: 10 second timeout for server selection
JWT_SECRET="<generate with: openssl rand -base64 32>"
JWT_REFRESH_SECRET="<generate with: openssl rand -base64 32>"
SENTRY_DSN=""
NODE_ENV="development"
PORT=5001
# Production frontend origin (required for CORS when NODE_ENV=production)
WEB_APP_URL="http://localhost:5173"
# Optional extra origins (comma-separated), e.g. external ordering app
# CORS_EXTRA_ORIGINS="https://ordering.example.com"
