generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  OWNER
  MANAGER
  CASHIER
  WAITER
  COOKER
  BARISTA
}

enum MenuCategory {
  FOOD
  DRINK
  DESSERT
  OTHER
}

enum OrderStatus {
  SUBMITTED
  IN_KITCHEN
  SERVED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE
  NONE
}

enum SettlementStatus {
  UNSETTLED
  PARTIALLY_SETTLED
  SETTLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HOLIDAY
  HALF_DAY
}

enum AttendanceSource {
  MANUAL
  SYSTEM_LOGIN
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SUPPLIES
  MAINTENANCE
  PAYROLL
  OTHER
}

enum NotificationType {
  MISSING_ATTENDANCE
  PRINTER_FAILURE
  PAYROLL_PERIOD_DUE
  MENU_ITEM_UNAVAILABLE
  SYSTEM_OVERRIDE
}

enum CancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShiftStatus {
  OPEN
  PENDING_REVIEW
  CLOSED
}

enum CashDrawerEventType {
  OPENING_BALANCE
  CASH_SETTLEMENT
  CASH_PAYOUT
  PETTY_CASH
  CASH_ADJUSTMENT
  CLOSING_BALANCE
}

enum VarianceClassification {
  BALANCED
  SHORT
  OVER
}

enum VarianceReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DailyCloseStatus {
  OPEN
  PENDING_REVIEW
  CLOSED
}

enum IntegritySeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum IntegrityCategory {
  OVER_SETTLEMENT
  ORPHAN_SETTLEMENT
  MISSING_SHIFT
  CLOSED_SHIFT_SETTLEMENT
  DUPLICATE_CLOSE
  NEGATIVE_TOTAL
  BROKEN_LEDGER
}

// ---------- Models ----------

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  role         Role
  email        String?  @unique
  phone        String
  passwordHash String?
  salaryAmount      Int      @default(0) // Stored in minor units (e.g. cents)
  isActive          Boolean  @default(true)
  preferredLanguage String   @default("en")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations (reverse side, no FK column on this model)
  ordersAsWaiter    Order[]        @relation("WaiterOrders")
  ordersAsCashier   Order[]        @relation("CashierOrders")
  ordersCancelled   Order[]        @relation("CancelledByUser")
  settlementsRecorded Settlement[] @relation("SettlementsRecorded")
  attendanceRecords Attendance[]
  paymentsReceived  UserPayment[]  @relation("PaymentRecipient")
  payrollsProcessed UserPayment[]  @relation("PayrollProcessor")
  loginAttempt      LoginAttempt?
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  adjustmentsProcessed PayrollAdjustment[] @relation("AdjustmentProcessor")
  expensesRecorded  Expense[]          @relation("ExpenseRecorder")
  cancellationRequestsCreated OrderCancellationRequest[] @relation("CancellationRequester")
  cancellationRequestsApproved OrderCancellationRequest[] @relation("CancellationApprover")

  cashierShiftsAsCashier CashierShift[] @relation("CashierShifts")
  cashierShiftsOpened    CashierShift[] @relation("ShiftOpenedBy")
  cashierShiftsClosed    CashierShift[] @relation("ShiftClosedBy")
  cashierShiftsReviewed  CashierShift[] @relation("ShiftReviewedBy")
  cashDrawerEvents       CashDrawerEvent[] @relation("CashDrawerEventPerformedBy")
  varianceReviews        VarianceReview[] @relation("VarianceReviewedBy")
  dailyClosesClosed      DailyClose[] @relation("DailyCloseClosedBy")

  @@index([role, isActive])
  @@map("users")
}

model MenuItem {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  category    MenuCategory
  price       Int      // Stored in minor units
  isAvailable Boolean      @default(true)
  imageUrl    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([category, isAvailable])
  @@map("menuitems")
}

// Composite (embedded) type — mirrors the original embedded orderItemSchema
type OrderItem {
  menuItemId String @db.ObjectId
  name       String // snapshot at sale time — never re-read from MenuItem later
  unitPrice  Int // snapshot at sale time, stored in minor units
  quantity   Int
  notes      String @default("")
}

model Order {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  clientOrderId      String           @unique
  tableNumber        String
  waiterId           String           @db.ObjectId
  waiter             User             @relation("WaiterOrders", fields: [waiterId], references: [id])
  cashierId          String?          @db.ObjectId
  cashier            User?            @relation("CashierOrders", fields: [cashierId], references: [id])
  items              OrderItem[]
  totalAmount        Int
  status             OrderStatus      @default(SUBMITTED)
  settlementStatus   SettlementStatus @default(UNSETTLED)
  isPaid             Boolean          @default(false) // Deprecated: use settlementStatus instead
  paymentMethod      PaymentMethod    @default(NONE) // Deprecated: check settlements instead
  cancellationReason String           @default("")
  cancelledById      String?          @db.ObjectId
  cancelledBy        User?            @relation("CancelledByUser", fields: [cancelledById], references: [id])
  paidAt             DateTime?        // Deprecated: check settlements instead
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Relations
  settlements Settlement[]
  cancellationRequests OrderCancellationRequest[]

  @@index([status, createdAt])
  @@index([settlementStatus, createdAt])
  @@index([waiterId, createdAt])
  @@index([cashierId, createdAt])
  @@map("orders")
}

model Settlement {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId         String        @db.ObjectId
  order           Order         @relation(fields: [orderId], references: [id])
  amountMinor     Int           // Amount in minor units (e.g., cents)
  method          PaymentMethod
  reference       String        @default("") // External transaction reference/receipt number
  note            String        @default("")
  recordedById    String        @db.ObjectId
  recordedBy      User          @relation("SettlementsRecorded", fields: [recordedById], references: [id])
  idempotencyKey  String?       @unique // For idempotent operations - @unique already creates an index
  recordedAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())

  @@index([orderId, createdAt])
  @@index([recordedById, createdAt])
  @@map("settlements")
}

model OrderCancellationRequest {
  id             String                    @id @default(auto()) @map("_id") @db.ObjectId
  orderId        String                    @db.ObjectId
  order          Order                     @relation(fields: [orderId], references: [id])
  requestedById  String                    @db.ObjectId
  requestedBy    User                      @relation("CancellationRequester", fields: [requestedById], references: [id])
  reason         String                    // Why the order needs to be cancelled
  status         CancellationRequestStatus @default(PENDING)
  approvedById   String?                   @db.ObjectId
  approvedBy     User?                     @relation("CancellationApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectedReason String?                   // Why the request was rejected (if applicable)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([orderId, status, createdAt])
  @@index([requestedById, createdAt])
  @@index([status, createdAt])
  @@map("order_cancellation_requests")
}

model Attendance {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  user      User             @relation(fields: [userId], references: [id])
  date      String // "YYYY-MM-DD", business-local
  status    AttendanceStatus
  source    AttendanceSource @default(MANUAL)
  note      String           @default("")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@map("attendance")
}

model UserPayment {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  user          User     @relation("PaymentRecipient", fields: [userId], references: [id])
  paymentDate   DateTime @default(now())
  periodMonth   Int // 1–12, validate in application layer
  periodYear    Int
  baseSalary    Int // reference figure only
  paidAmount    Int // actual amount paid, minor units
  note          String   @default("")
  processedById String   @db.ObjectId
  processedBy   User     @relation("PayrollProcessor", fields: [processedById], references: [id])
  adjustments   PayrollAdjustment[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, periodMonth, periodYear])
  @@index([periodYear, periodMonth])
  @@map("user_payments")
}

model LoginAttempt {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @unique @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  failedCount Int      @default(0)
  lockedUntil Float    @default(0) // timestamp
  updatedAt   DateTime @updatedAt

  @@map("login_attempts")
}

model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String   @unique // Store hash of refresh token
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  timestamp  DateTime @default(now())
  actorId    String   @db.ObjectId
  actor      User     @relation(fields: [actorId], references: [id])
  actionType String
  targetType String
  targetId   String?  // Can be an order ID, user ID, etc.
  details    Json?    // Structured context

  @@index([actorId, timestamp])
  @@map("audit_logs")
}

model PrinterStation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  station   String   @unique
  ip        String
  port      Int      @default(9100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("printer_stations")
}

model PayrollAdjustment {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  originalPaymentId String      @db.ObjectId
  originalPayment   UserPayment @relation(fields: [originalPaymentId], references: [id])
  adjustmentAmount Int
  reason           String
  processedById    String      @db.ObjectId
  processedBy      User        @relation("AdjustmentProcessor", fields: [processedById], references: [id])
  createdAt        DateTime    @default(now())

  @@map("payroll_adjustments")
}

model Expense {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  category     ExpenseCategory
  amount       Int
  description  String
  date         DateTime
  recordedById String          @db.ObjectId
  recordedBy   User            @relation("ExpenseRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([date])
  @@index([category, date])
  @@map("expenses")
}

model Notification {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  type          NotificationType
  message       String
  severity      String // "info" | "warning" | "critical"
  recipientRole Role? // null = broadcast to Owner and Manager
  isRead        Boolean          @default(false)
  relatedId     String?
  createdAt     DateTime         @default(now())

  @@index([recipientRole, isRead, createdAt])
  @@map("notifications")
}

model SystemSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model CashierShift {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  cashierId         String       @db.ObjectId
  cashier           User         @relation("CashierShifts", fields: [cashierId], references: [id])
  status            ShiftStatus  @default(OPEN)
  openedAt          DateTime     @default(now())
  closedAt          DateTime?
  openingCashMinor  Int
  expectedCashMinor Int?
  declaredCashMinor Int?
  varianceMinor     Int?
  openedById        String       @db.ObjectId
  openedBy          User         @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedById        String?      @db.ObjectId
  closedBy          User?        @relation("ShiftClosedBy", fields: [closedById], references: [id])
  reviewedById      String?      @db.ObjectId
  reviewedBy        User?        @relation("ShiftReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  reviewNotes       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  cashDrawerEvents  CashDrawerEvent[]
  varianceReviews   VarianceReview[]

  @@index([cashierId, status, openedAt])
  @@map("cashier_shifts")
}

model CashDrawerEvent {
  id              String              @id @default(auto()) @map("_id") @db.ObjectId
  shiftId         String              @db.ObjectId
  shift           CashierShift        @relation(fields: [shiftId], references: [id])
  type            CashDrawerEventType
  amountMinor     Int
  referenceType   String?
  referenceId     String?
  performedById   String              @db.ObjectId
  performedBy     User                @relation("CashDrawerEventPerformedBy", fields: [performedById], references: [id])
  notes           String?
  createdAt       DateTime            @default(now())

  @@index([shiftId, type, createdAt])
  @@map("cash_drawer_events")
}

model VarianceReview {
  id              String                 @id @default(auto()) @map("_id") @db.ObjectId
  shiftId         String                 @db.ObjectId
  shift           CashierShift           @relation(fields: [shiftId], references: [id])
  varianceMinor   Int
  classification  VarianceClassification
  cashierReason   String
  reviewStatus    VarianceReviewStatus   @default(PENDING)
  reviewedById    String?                @db.ObjectId
  reviewedBy      User?                  @relation("VarianceReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  managerNotes    String?
  createdAt       DateTime               @default(now())

  @@index([reviewStatus, createdAt])
  @@map("variance_reviews")
}

model DailyClose {
  id                     String           @id @default(auto()) @map("_id") @db.ObjectId
  businessDate           String           @unique // "YYYY-MM-DD"
  status                 DailyCloseStatus @default(OPEN)
  totalSalesMinor        Int              @default(0)
  totalSettledMinor      Int              @default(0)
  cashSettledMinor       Int              @default(0)
  cardSettledMinor       Int              @default(0)
  mobileSettledMinor     Int              @default(0)
  otherSettledMinor      Int              @default(0)
  cashExpectedMinor      Int              @default(0)
  cashDeclaredMinor      Int              @default(0)
  cashVarianceMinor      Int              @default(0)
  unsettledOrderCount    Int              @default(0)
  partialSettlementCount Int              @default(0)
  cancelledOrderCount    Int              @default(0)
  closedById             String?          @db.ObjectId
  closedBy               User?            @relation("DailyCloseClosedBy", fields: [closedById], references: [id])
  closedAt               DateTime?
  reviewNotes            String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([businessDate, status])
  @@map("daily_closes")
}

model IntegrityIssue {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  severity        IntegritySeverity
  category        IntegrityCategory
  description     String
  referenceType   String?
  referenceId     String?
  resolved        Boolean           @default(false)
  createdAt       DateTime          @default(now())

  @@index([severity, resolved])
  @@map("integrity_issues")
}
