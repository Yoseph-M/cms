generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  OWNER
  MANAGER
  CASHIER
  WAITER
  COOKER
  BARISTA
}

enum MenuCategory {
  FOOD
  DRINK
  DESSERT
  OTHER
}

enum OrderStatus {
  SUBMITTED
  IN_KITCHEN
  SERVED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE
  NONE
}

enum SettlementStatus {
  UNSETTLED
  PARTIALLY_SETTLED
  SETTLED
}

enum PrintTransport {
  BLUETOOTH
  USB
  NETWORK // Wi-Fi / Ethernet ESC-POS printer the server talks to directly (no browser, no agent)
}

enum PrintJobStatus {
  QUEUED
  PRINTING
  PRINTED
  FAILED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HOLIDAY
  HALF_DAY
}

enum AttendanceSource {
  MANUAL
  SYSTEM_LOGIN
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SUPPLIES
  MAINTENANCE
  PAYROLL
  OTHER
}

enum NotificationType {
  MISSING_ATTENDANCE
  PRINTER_FAILURE
  PAYROLL_PERIOD_DUE
  MENU_ITEM_UNAVAILABLE
  SYSTEM_OVERRIDE
  DAILY_CLOSE_REQUESTED // cashier asked to close the day — managers decide
  DAILY_CLOSE_DECISION  // manager approved/rejected — the requesting cashier is told
}

enum CancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShiftStatus {
  OPEN
  PENDING_REVIEW
  CLOSED
}

enum CashDrawerEventType {
  OPENING_BALANCE    // Initial cash at shift start (ledger movement)
  CASH_SETTLEMENT    // Cash received from customer (ledger movement)
  CASH_PAYOUT        // Cash removed from drawer (ledger movement)
  PETTY_CASH         // Small operational expense (ledger movement)
  CASH_ADJUSTMENT    // Compensating event for corrections (ledger movement)
  CLOSING_BALANCE    // DEPRECATED: Physical count should be in shift record, not ledger
}

enum VarianceClassification {
  BALANCED
  SHORT
  OVER
}

enum VarianceReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DailyCloseStatus {
  OPEN
  PENDING_REVIEW // a cashier requested the close; awaiting the manager's decision
  CLOSED        // approved by a manager
  REJECTED      // declined by a manager; the cashier can request again
}

enum IntegritySeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum IntegrityCategory {
  OVER_SETTLEMENT
  ORPHAN_SETTLEMENT
  MISSING_SHIFT
  CLOSED_SHIFT_SETTLEMENT
  DUPLICATE_CLOSE
  NEGATIVE_TOTAL
  BROKEN_LEDGER
}

enum MarketplaceMemberRole {
  OWNER
  MANAGER
}

enum MarketplaceOrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum MarketplacePaymentMethod {
  CASH_ON_DELIVERY
  PAY_AT_STORE
}

enum MarketplacePaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PurchaseOrderStatus {
  OPEN
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum CashDrawerEntryType {
  OPENING_FLOAT
  CASH_IN
  CASH_OUT
  PETTY_CASH
  ADJUSTMENT
}

// ---------- Models ----------

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  role         Role
  username     String?  @unique
  phone        String
  avatarUrl    String?
  passwordHash String?
  /// PIN for the mobile app (waiters, cooks, baristas — and managers, who use
  /// both). Hashed like a password, stored separately so the app credential and
  /// the website password rotate independently.
  pinCodeHash  String?
  salaryAmount      Int      @default(0) // Stored in ETB as entered (major units)
  isActive          Boolean  @default(true)
  preferredLanguage String   @default("en")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations (reverse side, no FK column on this model)
  ordersAsWaiter    Order[]        @relation("WaiterOrders")
  ordersAsCashier   Order[]        @relation("CashierOrders")
  ordersCancelled   Order[]        @relation("CancelledByUser")
  settlementsRecorded Settlement[] @relation("SettlementsRecorded")
  attendanceRecords Attendance[]
  paymentsReceived  UserPayment[]  @relation("PaymentRecipient")
  payrollsProcessed UserPayment[]  @relation("PayrollProcessor")
  loginAttempt      LoginAttempt?
  loginHistory      LoginHistory[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  adjustmentsProcessed PayrollAdjustment[] @relation("AdjustmentProcessor")
  expensesRecorded  Expense[]          @relation("ExpenseRecorder")
  cancellationRequestsCreated OrderCancellationRequest[] @relation("CancellationRequester")
  cancellationRequestsApproved OrderCancellationRequest[] @relation("CancellationApprover")

  cashierShiftsAsCashier CashierShift[] @relation("CashierShifts")
  cashierShiftsOpened    CashierShift[] @relation("ShiftOpenedBy")
  cashierShiftsClosed    CashierShift[] @relation("ShiftClosedBy")
  cashierShiftsReviewed  CashierShift[] @relation("ShiftReviewedBy")
  cashDrawerEvents       CashDrawerEvent[] @relation("CashDrawerEventPerformedBy")
  varianceReviews        VarianceReview[] @relation("VarianceReviewedBy")
  dailyClosesClosed      DailyClose[] @relation("DailyCloseClosedBy")
  dailyClosesRequested   DailyClose[] @relation("DailyCloseRequestedBy")
  integrityIssuesResolved IntegrityIssue[] @relation("IntegrityIssuesResolved")
  marketplaceMemberships MarketplaceBusinessMember[]
  purchasesCreated      PurchaseOrder[] @relation("PurchaseCreator")
  purchasesReceived     PurchaseOrder[] @relation("PurchaseReceiver")
  cashDrawerEntries     CashDrawerEntry[]

  @@index([role, isActive])
  @@map("users")
}

model MenuItem {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  nameAmharic String?
  category    MenuCategory
  price       Int      // Stored in ETB as a whole number (no cents)
  sku         String?
  barcode     String?
  cost        Int?     // Unit cost in ETB; used for margin reporting
  trackInventory Boolean @default(false)
  stockQuantity Int?    @default(0)
  lowStockThreshold Int? @default(5)
  isAvailable Boolean      @default(true)
  imageUrl    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  stockMovements StockMovement[]

  @@index([category, isAvailable])
  @@index([barcode])
  @@index([sku])
  @@index([trackInventory, stockQuantity])
  @@map("menuitems")
}

model Customer {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  phone                 String   @default("")
  email                 String   @default("")
  notes                 String   @default("")
  discountPercent       Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  orders Order[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

model StockMovement {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  menuItemId  String   @db.ObjectId
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
  delta       Int      // Positive for receiving/return; negative for sale/adjustment
  reason      String   // SALE, RECEIVING, ADJUSTMENT, RETURN
  reference   String?
  performedById String @db.ObjectId
  createdAt   DateTime @default(now())

  @@index([menuItemId, createdAt])
  @@index([reason, createdAt])
  @@map("stock_movements")
}

model Supplier {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  contactName   String          @default("")
  phone         String          @default("")
  email         String          @default("")
  address       String          @default("")
  notes         String          @default("")
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([name, isActive])
  @@map("suppliers")
}

type PurchaseOrderLine {
  menuItemId       String @db.ObjectId
  name             String
  quantityOrdered  Int
  quantityReceived Int    @default(0)
  unitCost         Int
}

model PurchaseOrder {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  purchaseNumber String             @unique
  supplierId     String             @db.ObjectId
  supplier       Supplier           @relation(fields: [supplierId], references: [id])
  items          PurchaseOrderLine[]
  status         PurchaseOrderStatus @default(OPEN)
  subtotal       Int
  notes          String             @default("")
  createdById    String             @db.ObjectId
  createdBy      User               @relation("PurchaseCreator", fields: [createdById], references: [id])
  receivedById   String?            @db.ObjectId
  receivedBy     User?              @relation("PurchaseReceiver", fields: [receivedById], references: [id])
  receivedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([supplierId, createdAt])
  @@index([status, createdAt])
  @@map("purchase_orders")
}

model CashDrawerEntry {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  businessDate   String              // YYYY-MM-DD in the operator's local business day
  type           CashDrawerEntryType
  amount         Int                 // ETB whole units; positive magnitude for each movement
  description    String              @default("")
  reference      String              @default("")
  idempotencyKey String?             @unique
  openingFloatKey String?            @unique
  createdById    String              @db.ObjectId
  createdBy      User                @relation(fields: [createdById], references: [id])
  createdAt      DateTime            @default(now())

  @@index([businessDate, createdAt])
  @@index([type, businessDate])
  @@map("cash_drawer_entries")
}

/// Separate merchant workspace for the public multi-business marketplace.
/// The current restaurant POS records remain in their existing collections.
model MarketplaceBusiness {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  category    String
  description String   @default("")
  address     String   @default("")
  phone       String   @default("")
  email       String   @default("")
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members        MarketplaceBusinessMember[]
  products       MarketplaceProduct[]
  deliveryZones  MarketplaceDeliveryZone[]
  orders         MarketplaceOrder[]

  @@index([isActive, category, name])
  @@map("marketplace_businesses")
}

model MarketplaceBusinessMember {
  id         String                 @id @default(auto()) @map("_id") @db.ObjectId
  businessId String                 @db.ObjectId
  business   MarketplaceBusiness    @relation(fields: [businessId], references: [id])
  userId     String                 @db.ObjectId
  user       User                   @relation(fields: [userId], references: [id])
  role       MarketplaceMemberRole  @default(MANAGER)
  createdAt  DateTime               @default(now())

  @@unique([businessId, userId])
  @@index([userId])
  @@map("marketplace_business_members")
}

model MarketplaceProduct {
  id            String              @id @default(auto()) @map("_id") @db.ObjectId
  businessId    String              @db.ObjectId
  business      MarketplaceBusiness @relation(fields: [businessId], references: [id])
  name          String
  description   String              @default("")
  category      String
  sku           String              @default("")
  barcode       String              @default("")
  price         Int
  cost          Int                 @default(0)
  stockQuantity Int                 @default(0)
  lowStockAt    Int                 @default(3)
  imageUrl      String?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  variants MarketplaceProductVariant[]
  stockMovements MarketplaceStockMovement[]

  @@index([businessId, isActive, category])
  @@index([businessId, name])
  @@index([sku])
  @@index([barcode])
  @@map("marketplace_products")
}

model MarketplaceProductVariant {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  productId     String            @db.ObjectId
  product       MarketplaceProduct @relation(fields: [productId], references: [id])
  name          String
  sku           String            @default("")
  price         Int
  stockQuantity Int               @default(0)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  stockMovements MarketplaceStockMovement[]

  @@index([productId, isActive])
  @@index([sku])
  @@map("marketplace_product_variants")
}

model MarketplaceStockMovement {
  id          String                    @id @default(auto()) @map("_id") @db.ObjectId
  businessId  String                    @db.ObjectId
  productId   String                    @db.ObjectId
  product     MarketplaceProduct        @relation(fields: [productId], references: [id])
  variantId   String?                   @db.ObjectId
  variant     MarketplaceProductVariant? @relation(fields: [variantId], references: [id])
  delta       Int
  reason      String                    // OPENING_BALANCE, RECEIVING, ADJUSTMENT, SALE, CANCELLATION
  reference   String?
  performedById String?                 @db.ObjectId // null for public checkout
  createdAt   DateTime                  @default(now())

  @@index([businessId, createdAt])
  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([reason, reference])
  @@map("marketplace_stock_movements")
}

model MarketplaceDeliveryZone {
  id                  String              @id @default(auto()) @map("_id") @db.ObjectId
  businessId          String              @db.ObjectId
  business            MarketplaceBusiness @relation(fields: [businessId], references: [id])
  name                String
  deliveryFee         Int                 @default(0)
  minimumOrderAmount  Int                 @default(0)
  estimatedMinutes   Int                 @default(45)
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  orders MarketplaceOrder[]

  @@index([businessId, isActive, name])
  @@map("marketplace_delivery_zones")
}

type MarketplaceOrderLine {
  productId     String @db.ObjectId
  variantId     String? @db.ObjectId
  name          String
  variantName   String @default("")
  sku           String @default("")
  unitPrice     Int
  quantity      Int
}

model MarketplaceOrder {
  id             String                   @id @default(auto()) @map("_id") @db.ObjectId
  clientOrderId  String                   @unique
  businessId     String                   @db.ObjectId
  business       MarketplaceBusiness      @relation(fields: [businessId], references: [id])
  deliveryZoneId String?                  @db.ObjectId
  deliveryZone   MarketplaceDeliveryZone?  @relation(fields: [deliveryZoneId], references: [id])
  customerName   String
  customerPhone  String
  customerEmail  String                   @default("")
  deliveryAddress String                  @default("")
  note           String                   @default("")
  items          MarketplaceOrderLine[]
  subtotal       Int
  deliveryFee    Int                      @default(0)
  totalAmount    Int
  paymentMethod  MarketplacePaymentMethod @default(CASH_ON_DELIVERY)
  paymentStatus  MarketplacePaymentStatus @default(UNPAID)
  status         MarketplaceOrderStatus   @default(PLACED)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([businessId, status, createdAt])
  @@index([customerPhone, createdAt])
  @@map("marketplace_orders")
}

// Composite (embedded) type — mirrors the original embedded orderItemSchema
type OrderItem {
  menuItemId String @db.ObjectId
  name       String // snapshot at sale time — never re-read from MenuItem later
  unitPrice  Int // snapshot at sale time, stored in ETB as a whole number
  quantity   Int
  notes      String @default("")
}

model Order {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  clientOrderId      String           @unique
  tableNumber        String
  waiterId           String           @db.ObjectId
  waiter             User             @relation("WaiterOrders", fields: [waiterId], references: [id])
  cashierId          String?          @db.ObjectId
  cashier            User?            @relation("CashierOrders", fields: [cashierId], references: [id])
  items              OrderItem[]
  customerId         String?          @db.ObjectId
  customer           Customer?        @relation(fields: [customerId], references: [id])
  totalAmount        Int
  status             OrderStatus      @default(SUBMITTED)
  settlementStatus   SettlementStatus @default(UNSETTLED)
  isPaid             Boolean          @default(false) // Deprecated: use settlementStatus instead
  paymentMethod      PaymentMethod    @default(NONE) // Deprecated: check settlements instead
  cancellationReason String           @default("")
  cancelledById      String?          @db.ObjectId
  cancelledBy        User?            @relation("CancelledByUser", fields: [cancelledById], references: [id])
  paidAt             DateTime?        // Deprecated: check settlements instead
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Relations
  settlements Settlement[]
  cancellationRequests OrderCancellationRequest[]
  printJobs PrintJob[]

  @@index([status, createdAt])
  @@index([settlementStatus, createdAt])
  @@index([waiterId, createdAt])
  @@index([cashierId, createdAt])
  @@index([customerId, createdAt])
  @@map("orders")
}

model Settlement {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId         String        @db.ObjectId
  order           Order         @relation(fields: [orderId], references: [id])
  amountMinor     Int           // Amount in ETB as a whole number (no cents)
  method          PaymentMethod
  reference       String        @default("") // External transaction reference/receipt number
  note            String        @default("")
  recordedById    String        @db.ObjectId
  recordedBy      User          @relation("SettlementsRecorded", fields: [recordedById], references: [id])
  shiftId         String?       @db.ObjectId // DEPRECATED: always null now (shift management removed)
  idempotencyKey  String?       @unique // For idempotent operations - @unique already creates an index
  recordedAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())

  @@index([orderId, createdAt])
  @@index([recordedById, createdAt])
  @@index([shiftId, createdAt])
  @@map("settlements")
}

model OrderCancellationRequest {
  id             String                    @id @default(auto()) @map("_id") @db.ObjectId
  orderId        String                    @db.ObjectId
  order          Order                     @relation(fields: [orderId], references: [id])
  requestedById  String                    @db.ObjectId
  requestedBy    User                      @relation("CancellationRequester", fields: [requestedById], references: [id])
  reason         String                    // Why the order needs to be cancelled
  status         CancellationRequestStatus @default(PENDING)
  approvedById   String?                   @db.ObjectId
  approvedBy     User?                     @relation("CancellationApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectedReason String?                   // Why the request was rejected (if applicable)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([orderId, status, createdAt])
  @@index([requestedById, createdAt])
  @@index([status, createdAt])
  @@map("order_cancellation_requests")
}

model Attendance {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  user      User             @relation(fields: [userId], references: [id])
  date      String // "YYYY-MM-DD", business-local
  status    AttendanceStatus
  source    AttendanceSource @default(MANUAL)
  note      String           @default("")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@map("attendance")
}

model UserPayment {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  user          User     @relation("PaymentRecipient", fields: [userId], references: [id])
  paymentDate   DateTime @default(now())
  periodMonth   Int // 1–12, validate in application layer
  periodYear    Int
  baseSalary    Int // reference figure only
  paidAmount    Int // actual amount paid, ETB as entered
  note          String   @default("")
  processedById String   @db.ObjectId
  processedBy   User     @relation("PayrollProcessor", fields: [processedById], references: [id])
  adjustments   PayrollAdjustment[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, periodMonth, periodYear])
  @@index([periodYear, periodMonth])
  @@map("user_payments")
}

model LoginAttempt {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @unique @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  failedCount Int      @default(0)
  lockedUntil Float    @default(0) // timestamp
  updatedAt   DateTime @updatedAt

  @@map("login_attempts")
}

model LoginHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  ip        String?
  userAgent String?
  outcome   String   // "SUCCESS", "FAILURE", "LOCKED"
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("login_history")
}

model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String   @unique // Store hash of refresh token
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  timestamp  DateTime @default(now())
  actorId    String   @db.ObjectId
  actor      User     @relation(fields: [actorId], references: [id])
  actionType String
  targetType String
  targetId   String?  // Can be an order ID, user ID, etc.
  details    Json?    // Structured context

  @@index([actorId, timestamp])
  @@map("audit_logs")
}

model PrinterStation {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  station     String         @unique
  transport   PrintTransport @default(BLUETOOTH)
  macAddress  String?
  vendorId    String?
  productId   String?
  // NETWORK transport: the printer's address on the LAN. The backend prints to
  // it directly over TCP (raw ESC/POS, port 9100 by default), so no browser or
  // local print agent has to be running.
  ip          String?
  port        Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("printer_stations")
}

model PrintAgent {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  name            String    @unique
  station         String    // Required: kitchen, bar, cashier, etc.
  tokenHash       String    @unique
  isRevoked       Boolean   @default(false)
  lastHeartbeat   DateTime?
  version         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  printJobs       PrintJob[] @relation("AgentPrintJobs")

  @@index([station, isRevoked])
  @@map("print_agents")
}

model PrintJob {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  orderId       String?        @db.ObjectId
  order         Order?         @relation(fields: [orderId], references: [id])
  station       String
  transport     PrintTransport
  status        PrintJobStatus @default(QUEUED)
  attempts      Int            @default(0)
  maxAttempts   Int            @default(3)
  printerMacAddress String?
  printerVendorId   String?
  printerProductId  String?
  payloadBase64     String
  lastError     String?
  claimedById   String?        @db.ObjectId
  claimedBy     PrintAgent?    @relation("AgentPrintJobs", fields: [claimedById], references: [id])
  claimedAt     DateTime?      // When job was claimed (for lease tracking)
  lastAttemptAt DateTime?      // Last server-side dispatch attempt (NETWORK transport)
  printedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, station, createdAt])
  @@index([status, createdAt])
  @@index([orderId, createdAt])
  @@index([station, status])
  @@index([claimedById, status])
  @@map("print_jobs")
}

model PayrollAdjustment {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  originalPaymentId String      @db.ObjectId
  originalPayment   UserPayment @relation(fields: [originalPaymentId], references: [id])
  adjustmentAmount Int
  reason           String
  processedById    String      @db.ObjectId
  processedBy      User        @relation("AdjustmentProcessor", fields: [processedById], references: [id])
  createdAt        DateTime    @default(now())

  @@map("payroll_adjustments")
}

model Expense {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  category     ExpenseCategory
  amount       Int
  description  String
  date         DateTime
  recordedById String          @db.ObjectId
  recordedBy   User            @relation("ExpenseRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([date])
  @@index([category, date])
  @@map("expenses")
}

model Notification {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  type          NotificationType
  message       String
  severity      String // "info" | "warning" | "critical"
  recipientRole Role? // null = broadcast to Owner and Manager
  isRead        Boolean          @default(false)
  relatedId     String?
  createdAt     DateTime         @default(now())

  @@index([recipientRole, isRead, createdAt])
  @@map("notifications")
}

model SystemSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

/// DEPRECATED — shift management has been removed from the application. This
/// model is retained only so existing installations keep their historical rows;
/// no application code creates or reads shifts anymore. Do not add new usage.
model CashierShift {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  cashierId         String       @db.ObjectId
  cashier           User         @relation("CashierShifts", fields: [cashierId], references: [id])
  status            ShiftStatus  @default(OPEN)
  openedAt          DateTime     @default(now())
  closedAt          DateTime?
  openingCashMinor  Int          // Initial cash in drawer (ETB whole numbers)
  expectedCashMinor Int?         // CALCULATED from ledger: opening + sales - payouts ± adjustments
  declaredCashMinor Int?         // PHYSICAL COUNT: what cashier actually counted
  varianceMinor     Int?         // DERIVED: declaredCashMinor - expectedCashMinor
  
  expectedCardMinor   Int?       // CALCULATED from settlements
  declaredCardMinor   Int?       // PHYSICAL COUNT from cashier
  expectedMobileMinor Int?       // CALCULATED from settlements
  declaredMobileMinor Int?       // PHYSICAL COUNT from cashier
  
  openedById        String       @db.ObjectId
  openedBy          User         @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedById        String?      @db.ObjectId
  closedBy          User?        @relation("ShiftClosedBy", fields: [closedById], references: [id])
  reviewedById      String?      @db.ObjectId
  reviewedBy        User?        @relation("ShiftReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  reviewNotes       String?
  openIdempotencyKey  String?    @unique // For idempotent shift open operations
  closeIdempotencyKey String?    @unique // For idempotent shift close operations
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  cashDrawerEvents  CashDrawerEvent[]
  varianceReviews   VarianceReview[]

  @@index([cashierId, status, openedAt])
  @@map("cashier_shifts")
}

/// DEPRECATED — the cash drawer ledger is no longer written. Retained for
/// historical rows only. Do not add new usage.
model CashDrawerEvent {
  id              String              @id @default(auto()) @map("_id") @db.ObjectId
  shiftId         String              @db.ObjectId
  shift           CashierShift        @relation(fields: [shiftId], references: [id])
  type            CashDrawerEventType
  amountMinor     Int
  referenceType   String?
  referenceId     String?
  performedById   String              @db.ObjectId
  performedBy     User                @relation("CashDrawerEventPerformedBy", fields: [performedById], references: [id])
  notes           String?
  idempotencyKey  String?             @unique // For idempotent payout/petty-cash/adjustment operations
  createdAt       DateTime            @default(now())

  @@index([shiftId, type, createdAt])
  @@map("cash_drawer_events")
}

/// DEPRECATED — variance review was part of shift management. Retained for
/// historical rows only. Do not add new usage.
model VarianceReview {
  id              String                 @id @default(auto()) @map("_id") @db.ObjectId
  shiftId         String                 @db.ObjectId
  shift           CashierShift           @relation(fields: [shiftId], references: [id])
  varianceMinor   Int                    // Cash variance (ETB whole numbers)
  cardVarianceMinor   Int?               // Card variance
  mobileVarianceMinor Int?               // Mobile variance
  classification  VarianceClassification
  cashierReason   String
  reviewStatus    VarianceReviewStatus   @default(PENDING)
  reviewedById    String?                @db.ObjectId
  reviewedBy      User?                  @relation("VarianceReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  managerNotes    String?
  idempotencyKey  String?                @unique // For idempotent variance submission
  createdAt       DateTime               @default(now())

  @@index([reviewStatus, createdAt])
  @@map("variance_reviews")
}

model DailyClose {
  id                     String           @id @default(auto()) @map("_id") @db.ObjectId
  businessDate           String           @unique // "YYYY-MM-DD"
  status                 DailyCloseStatus @default(OPEN)
  totalSalesMinor        Int              @default(0)
  totalSettledMinor      Int              @default(0)
  cashSettledMinor       Int              @default(0)
  cardSettledMinor       Int              @default(0)
  mobileSettledMinor     Int              @default(0)
  otherSettledMinor      Int              @default(0)
  cashExpectedMinor      Int              @default(0)
  cashDeclaredMinor      Int              @default(0)
  cashVarianceMinor      Int              @default(0)
  unsettledOrderCount    Int              @default(0)
  partialSettlementCount Int              @default(0)
  cancelledOrderCount    Int              @default(0)
  // The cashier who asked for the day to close. Kept separate from closedBy so
  // the approval screen can show who sent the request and who decided it.
  requestedById          String?          @db.ObjectId
  requestedBy            User?            @relation("DailyCloseRequestedBy", fields: [requestedById], references: [id])
  requestedAt            DateTime?
  closedById             String?          @db.ObjectId
  closedBy               User?            @relation("DailyCloseClosedBy", fields: [closedById], references: [id])
  closedAt               DateTime?
  reviewNotes            String?
  idempotencyKey         String?          @unique // For idempotent daily close operations
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([businessDate, status])
  @@map("daily_closes")
}

model IntegrityIssue {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  severity        IntegritySeverity
  category        IntegrityCategory
  description     String
  referenceType   String?
  referenceId     String?
  resolved        Boolean           @default(false)
  resolvedAt      DateTime?         // When the issue was resolved
  resolvedById    String?           @db.ObjectId // Who resolved it
  resolvedBy      User?             @relation("IntegrityIssuesResolved", fields: [resolvedById], references: [id])
  resolutionNotes String?           // Why/how it was resolved
  createdAt       DateTime          @default(now())
  lastSeenAt      DateTime          @default(now()) // Last time this issue was detected

  @@index([severity, resolved])
  @@index([resolvedById, resolvedAt])
  @@index([category, referenceId, resolved]) // Composite index for duplicate detection
  @@map("integrity_issues")
}
