# CMS Print Agent Configuration

# Backend API URL (where your CMS backend is hosted)
CMS_API_URL=http://localhost:5000/api

# Agent Authentication Token (obtain from Owner -> Print Agents -> Register Agent)
AGENT_TOKEN=

# Agent Name (for identification in logs and dashboard)
AGENT_NAME=Cashier Computer 1

# Station Assignment (single station per agent)
# Options: kitchen, bar, cashier
# Must match the station assigned during agent registration
STATION=kitchen

# Log Level
LOG_LEVEL=info

# Poll Interval (milliseconds) - how often to check for pending jobs
POLL_INTERVAL_MS=3000

# Heartbeat Interval (milliseconds) - how often to send status updates to backend
HEARTBEAT_INTERVAL_MS=30000

# Connection Retry Settings (no maximum attempts - agent will retry indefinitely)
RECONNECT_DELAY_MS=5000
MAX_RECONNECT_DELAY_MS=60000
